use std/io

agent BurstBot {
  state {
    sent: int = 0
    dropped: int = 0
  }
  @on_start {
    for i in 1..5 {
      try {
        send(BurstBot, i)
        self.sent = self.sent + 1
      } catch e: RuntimeBusy {
        self.dropped = self.dropped + 1
      }
    }
    io.show("sent={self.sent} dropped={self.dropped}")
  }

  on message(n: int) {
    io.show("handled={n}")
  }
}

run(BurstBot)
