# Retry & Timeout
#
# Wrap unreliable work in resilience primitives. control.retry re-invokes
# the closure on every error until it succeeds or the budget is exhausted;
# control.with_timeout aborts the closure once the duration elapses.
#
# Demonstrates: control.retry, control.with_timeout, agent state, durations.
#
# Run:
#   KEEL_LLM=mock KEEL_ONESHOT=1 keel run examples/retry_on_failure.keel

use std/control
use std/io

agent Worker {
  @role "Resilient worker — retries flaky calls and bounds long ones"

  state {
    attempts: int = 0
  }

  @on_start {
    # Retry: the closure trips a NullError on the first 2 attempts
    # and returns "ok" on the 3rd. retry surfaces the third value.
    result = control.retry(5, () => {
      self.attempts = self.attempts + 1
      io.show("attempt #{self.attempts}")
      if self.attempts < 3 {
        x = none
        return "{x!}"
      }
      return "ok"
    })
    io.show("retry result: {result} after {self.attempts} attempts")

    # Timeout: the closure returns within the deadline so we get its value.
    quick = control.with_timeout(5.seconds, () => {
      return "fast-path"
    })
    io.show("timeout result: {quick}")
  }
}

run(Worker)
