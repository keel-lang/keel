# v0.1.3 Comprehensive Integration Test
# Tests all 4 features: @rules, Ai.summarize (format/max), Ai.prompt (response_format: json), Ai.extract(as: T)

type Invoice {
  vendor: str
  amount: float
  date: str
}

type Sentiment {
  score: int
  tone: str
}

agent V0_1_3_Tester {
  @role "AI quality assurance tester for Keel v0.1.3"
  @rules [
    "Never make assumptions about missing data",
    "Always provide structured responses",
    "Validate all inputs before processing"
  ]
  @model "glm-4.7-flash"

  @on_start {
    Io.show("=== v0.1.3 Feature Integration Test ===\n")

    # Feature 1: @rules injected into system prompt
    Io.show("1. Testing @rules injection...")
    Io.show("   @rules should appear in system prompt (enable KEEL_TRACE=1 to verify)\n")

    # Feature 2: Ai.summarize with format and max
    Io.show("2. Testing Ai.summarize(format:, max:)...")
    text = "Keel is a programming language where AI agents are first-class citizens. Built in Rust with async recursion, type inference, and LLM integration. The v0.1.3 release focuses on making all declared parameters reach the model."
    summary = Ai.summarize(text, format: bullets, max: 3, unit: sentences)
    Io.show({feature: "summarize", result: summary})
    Io.show("")

    # Feature 3: Ai.prompt with response_format: json
    Io.show("3. Testing Ai.prompt(response_format: json)...")
    json_prompt = Ai.prompt(
      system: "Analyze the sentiment of the following text. Return JSON with 'score' (1-10) and 'tone' (positive/neutral/negative) fields.",
      user: "I love this programming language! It's the best thing I've used in years.",
      response_format: json
    )
    Io.show({feature: "prompt_json", result: json_prompt})
    Io.show("")

    # Feature 4: Ai.extract with as: T (struct schema derivation)
    Io.show("4. Testing Ai.extract(as: T)...")
    invoice_text = "Invoice from TechCorp: $2500.50 on 2026-04-24"
    extracted = Ai.extract(invoice_text, as: Invoice)
    Io.show({feature: "extract_as_struct", result: extracted})
    Io.show("")

    # Bonus: Show that @rules + all features work together
    Io.show("5. Combined test: @rules + Ai.decide with actual context...")
    decision = Ai.decide(
      "Customer email: 'I've been waiting 2 weeks for support! This is ridiculous!!!' — Should we escalate?",
      options: ["escalate", "handle_internally", "defer"]
    )
    Io.show({feature: "combined_rules_and_decide", decision: decision})
    Io.show("")

    Io.show("=== All v0.1.3 features verified ===")

    stop(V0_1_3_Tester)
  }
}

run(V0_1_3_Tester)
