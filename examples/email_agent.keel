use std/ai
use std/email
use std/io
use std/memory
use std/schedule
use std/time

use std/testing

type Urgency = low | medium | high | critical

task triage(email: { body: str, from: str, subject: str }) -> Urgency {
  ai.classify(email.body, as: Urgency, considering: { "from a known VIP or executive": Urgency.critical, "mentions a deadline within 24h": Urgency.high, "asks a direct question": Urgency.medium, "newsletter or automated message": Urgency.low }) ?? Urgency.medium
}

task brief(email: { body: str }) -> str {
  ai.summarize(email.body, in: 1, unit: sentence) ?? "(no summary)"
}

task compose(email: { body: str, from: str }, guidance: str? = none) -> str {
  if guidance != none { ai.draft("response to {email.body}", tone: "professional", guidance: guidance) } else { ai.draft("response to {email.body}", tone: "friendly", max_length: 150) } ?? "(draft failed)"
}

test "triage uses mocked urgency" {
  testing.mock(ai.classify).returns(Urgency.high)
  email = { body: "deadline tomorrow", from: "ada@example.com", subject: "urgent" }
  assert triage(email) == Urgency.high
}

test "brief uses mocked summary" {
  testing.mock(ai.summarize).returns("Needs a reply.")
  assert brief({ body: "Can you review this today?" }) == "Needs a reply."
}

test "compose uses mocked draft" {
  testing.mock(ai.draft).returns("Thanks, I will handle it.")
  email = { body: "Can you review this?", from: "ada@example.com" }
  assert compose(email) == "Thanks, I will handle it."
}

agent EmailAssistant {
  @role "\n    You are a professional email assistant.\n    You triage incoming mail, reply to routine messages,\n    and escalate anything important.\n  "
  @tools [email]
  @memory persistent

  state {
    handled_count: int = 0
  }

  task handle(email: { body: str, from: str, subject: str }) {
    urgency = triage(email)
    summary = brief(email)
    when urgency {
      low => {
        io.notify("Archived: {email.subject} [{urgency}]")
        email.archive(email)
      }
      medium => {
        reply = compose(email)
        if io.confirm("Auto-reply to '{email.subject}':\n\n{reply}") {
          email.send(reply, to: email.from)
        }
      }
      high, critical => {
        io.notify("{urgency} email from {email.from}")
        io.show({ from: email.from, subject: email.subject, summary: summary, urgency: urgency })
        guidance = io.ask("How should I respond?")
        reply = compose(email, guidance)
        if io.confirm(reply) {
          email.send(reply, to: email.from)
        }
      }
    }
    memory.remember({ contact: email.from, subject: email.subject, urgency: urgency, handled_at: time.now() })
    self.handled_count = self.handled_count + 1
  }
  @on_start {
    schedule.every(5.minutes, () => {
      emails = email.fetch(unread: true)
      io.notify("{emails.count} new emails")
      for email in emails {
        self.handle(email)
      }
    })
  }
}

run(EmailAssistant)
