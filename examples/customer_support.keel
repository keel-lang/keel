use std/ai
use std/email
use std/io
use std/schedule

use std/testing

type Priority = low | medium | high | critical

type Category = billing | technical | account | general

task categorize(ticket: { body: str }) -> Category {
  ai.classify(ticket.body, as: Category) ?? Category.general
}

task prioritize(ticket: { body: str }) -> Priority {
  ai.classify(ticket.body, as: Priority, considering: { "account locked or hacked": Priority.critical, "payment failed or overcharged": Priority.high, "feature request": Priority.low }) ?? Priority.medium
}

task respond(ticket: { body: str, from: str }, category: Category) -> str {
  ai.draft("support response to {ticket.body}", tone: "empathetic and professional", guidance: "address the {category} issue directly") ?? "(could not draft response)"
}

test "categorize uses mocked category" {
  testing.mock(ai.classify).returns(Category.billing)
  assert categorize({ body: "payment failed" }) == Category.billing
}

test "prioritize uses mocked priority" {
  testing.mock(ai.classify).returns(Priority.high)
  assert prioritize({ body: "overcharged twice" }) == Priority.high
}

test "respond uses mocked draft" {
  testing.mock(ai.draft).returns("We can help with billing.")
  reply = respond({ body: "payment failed", from: "ada@example.com" }, Category.billing)
  assert reply == "We can help with billing."
}

agent SupportBot {
  @role "You handle customer support tickets with empathy and precision"
  @tools [email]

  state {
    resolved: int = 0
    escalated: int = 0
  }

  task handle(ticket: { body: str, from: str, subject: str }) {
    category = categorize(ticket)
    priority = prioritize(ticket)
    io.notify("{priority} {category}: {ticket.subject}")
    when priority {
      low, medium => {
        reply = respond(ticket, category)
        if io.confirm("Reply to {ticket.from}:\n\n{reply}") {
          email.send(reply, to: ticket.from)
        }
        self.resolved = self.resolved + 1
      }
      high => {
        reply = respond(ticket, category)
        io.show({ from: ticket.from, category: category, priority: priority })
        guidance = io.ask("Any additions to the draft?")
        final = ai.draft("revised response to {ticket.body}", tone: "professional", guidance: guidance) ?? reply
        if io.confirm(final) {
          email.send(final, to: ticket.from)
        }
        self.resolved = self.resolved + 1
      }
      critical => {
        io.notify("ESCALATING: {ticket.subject} from {ticket.from}")
        self.escalated = self.escalated + 1
      }
    }
    io.notify("Stats: {self.resolved} resolved, {self.escalated} escalated")
  }
  @on_start {
    schedule.every(2.minutes, () => {
      for ticket in email.fetch(unread: true) {
        self.handle(ticket)
      }
    })
  }
}

run(SupportBot)
