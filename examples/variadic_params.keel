use std/io

task join(...words: str) -> str {
  result = ""
  for w in words {
    result += w
  }
  result
}

task sum_with_bonus(bonus: int, ...nums: int) -> int {
  total = bonus
  for n in nums {
    total += n
  }
  total
}

test "join concatenates variadic words" {
  assert join("Hello", ", ", "world", "!") == "Hello, world!"
}

test "sum with bonus accepts spread arguments" {
  xs = [4, 5, 6]
  assert sum_with_bonus(10, 1, 2, 3, ...xs) == 31
}

agent Demo {
  @tools [io]
  @role "variadic demo"
  @on_start {
    greeting = join("Hello", ", ", "world", "!")
    io.show(greeting)
    xs = [4, 5, 6]
    total = sum_with_bonus(10, 1, 2, 3, ...xs)
    io.show("total: {total}")
  }
}

run(Demo)
