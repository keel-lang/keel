# Stringable — user-defined types in string interpolation
#
# Any type can participate in `"{expr}"` interpolation by implementing
# the built-in `Stringable` interface via an `impl` block.
#
# Run:
#   KEEL_LLM=mock KEEL_ONESHOT=1 keel run examples/stringable.keel

use std/io

type Point {
  x: int
  y: int
}

type Color {
  r: int
  g: int
  b: int
}

impl Stringable for Point {
  task to_str(self) -> str {
    "({self.x}, {self.y})"
  }
}

impl Stringable for Color {
  task to_str(self) -> str {
    "rgb({self.r}, {self.g}, {self.b})"
  }
}

task distance(a: Point, b: Point) -> str {
  dx = b.x - a.x
  dy = b.y - a.y
  "distance from {a} to {b} = {dx}dx + {dy}dy"
}

agent Demo {
  @role "Demonstrates Stringable impl blocks"

  @on_start {
    origin: Point = { x: 0, y: 0 }
    target: Point = { x: 3, y: 4 }
    bg: Color    = { r: 255, g: 128, b: 0 }

    io.show("origin = {origin}")
    io.show("target = {target}")
    io.show("color  = {bg}")
    io.show(distance(origin, target))

    # Explicit call also works
    io.show(origin.to_str())
  }
}

run(Demo)

# Tests — run with: keel test examples/stringable.keel
test "stringable drives interpolation" {
  origin: Point = { x: 0, y: 0 }
  target: Point = { x: 3, y: 4 }
  assert "{origin}" == "(0, 0)"
  assert distance(origin, target) == "distance from (0, 0) to (3, 4) = 3dx + 4dy"
  assert origin.to_str() == "(0, 0)"
}
