use std/ai
use std/io

type Domain = billing | technical | account | general

type Ticket {
  id: str
  body: str
  from: str
}

agent BillingSpecialist {
  @role "Billing support specialist — resolves payment and invoice queries"
  @rules ["Always acknowledge the charge before explaining it", "Offer a full refund if the charge cannot be justified"]

  state {
    resolved: int = 0
  }

  on handle(ticket: Ticket) {
    self.resolved = self.resolved + 1
    reply = ai.draft("Billing support reply to: {ticket.body}", tone: "empathetic and clear") ?? "(draft unavailable)"
    io.show("[Billing] {ticket.id} → {ticket.from}")
    io.show(reply)
  }
  @on_stop {
    io.show("Billing specialist closed — {self.resolved} tickets resolved")
  }
}

agent TechSpecialist {
  @role "Technical support engineer — resolves API and integration problems"
  @rules ["Include a minimal code example whenever possible", "Link to the relevant docs section"]

  state {
    resolved: int = 0
  }

  on handle(ticket: Ticket) {
    self.resolved = self.resolved + 1
    reply = ai.draft("Technical support reply to: {ticket.body}", tone: "precise", guidance: "include a code snippet if the issue involves an API or SDK") ?? "(draft unavailable)"
    io.show("[Tech] {ticket.id} → {ticket.from}")
    io.show(reply)
  }
  @on_stop {
    io.show("Tech specialist closed — {self.resolved} tickets resolved")
  }
}

agent Router {
  @role "Support router — classify each ticket and send it to the right specialist"

  state {
    dispatched: int = 0
  }

  task classify(ticket: Ticket) -> Domain {
    ai.classify(ticket.body, as: Domain, considering: { "invoice, charge, refund, payment, subscription": Domain.billing, "api, sdk, 4xx, integration, authentication": Domain.technical, "change email, delete account, password": Domain.account }) ?? Domain.general
  }
  @on_start {
    run(BillingSpecialist)
    run(TechSpecialist)
    tickets = [{ id: "T-001", body: "I was charged twice for my Pro subscription", from: "alice@example.com" }, { id: "T-002", body: "Getting 401 Unauthorized on every API call", from: "bob@example.com" }, { id: "T-003", body: "How do I change my account email address?", from: "carol@example.com" }, { id: "T-004", body: "Invoice shows the wrong company name", from: "dave@example.com" }]
    io.show("Router: {tickets.count()} tickets to process\n")
    for ticket in tickets {
      domain = self.classify(ticket)
      self.dispatched = self.dispatched + 1
      when domain {
        billing => {
          delegate(BillingSpecialist, "handle", ticket)
          io.show("{ticket.id} → billing specialist")
        }
        technical => {
          delegate(TechSpecialist, "handle", ticket)
          io.show("{ticket.id} → tech specialist")
        }
        _ => io.show("{ticket.id} → general queue (no specialist assigned)")
      }
    }
    stop(Router)
  }
  @on_stop {
    io.show("\nRouter closed — {self.dispatched} tickets dispatched this session")
  }
}

run(Router)
