use std/io

type Order {
  id: str
  status: str
  amount: float
  filled_at: str
}

type Config {
  host: str
  port: int
  debug: bool
}

task process_order(o: Order) -> Order {
  return { ...o, status: "filled", filled_at: "2024-01-15T10:30:00Z" }
}

task run_test() {
  pending: Order = { id: "ord-42", status: "pending", amount: 250.0, filled_at: "" }
  filled = process_order(pending)
  io.show("id:        {filled.id}")
  io.show("status:    {filled.status}")
  io.show("amount:    {filled.amount}")
  io.show("filled_at: {filled.filled_at}")
  base: Config = { host: "localhost", port: 8080, debug: false }
  dev = { ...base, debug: true }
  prod = { ...dev, host: "api.example.com", debug: false }
  io.show("prod host:  {prod.host}")
  io.show("prod port:  {prod.port}")
  io.show("prod debug: {prod.debug}")
}

run_test()

# Tests — run with: keel test examples/struct_spread_update.keel
test "spread copies unchanged fields" {
  pending: Order = { id: "ord-42", status: "pending", amount: 250.0, filled_at: "" }
  filled = process_order(pending)
  assert filled.status == "filled"
  assert filled.id == "ord-42"
  assert filled.amount == 250.0
}

test "later overrides win" {
  base: Config = { host: "localhost", port: 8080, debug: false }
  dev = { ...base, debug: true }
  prod = { ...dev, host: "api.example.com", debug: false }
  assert prod.host == "api.example.com"
  assert prod.port == 8080
  assert not prod.debug
}
