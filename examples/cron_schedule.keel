use std/io
use std/schedule

agent CronScheduler {
  @tools [io]
  state {
    run_count: int = 0
  }
  @on_start {
    schedule.cron("0 9 * * 1-5", () => {
      self.run_count = self.run_count + 1
      io.show("Morning digest triggered")
    })
    schedule.cron("*/5 * * * *", () => {
      io.show("Periodic task running")
    })
    schedule.cron("0 0 * * *", () => {
      io.show("Daily reset")
    })
    io.show("Cron tasks scheduled")
  }
}

run(CronScheduler)
