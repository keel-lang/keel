use std/io
use std/time

agent Timer {
  @tools [io]
  @on_start {
    t = time.now()
    io.show("Now: {t}")
    ny = time.now(tz: "America/New_York")
    io.show("New York: {ny}")
    deadline = time.now() + 3.days
    io.show("Deadline: {deadline}")
    past = time.now() - 1.hours
    io.show("An hour ago: {past}")
    parsed = time.parse("2026-05-01T09:00:00Z")
    io.show("Parsed: {parsed}")
    naive = time.parse("2026-05-01", tz: "UTC")
    io.show("Naive+tz: {naive}")
    bad = time.parse("2026-05-01")
    io.show("Naive without tz: {bad}")
    today = time.now().format(as: "%Y-%m-%d")
    io.show("Today: {today}")
    p = parsed.parts()
    io.show("Year: {p.year}, Month: {p.month}, TZ: {p.tz}")
    start = time.parse("2026-05-01T00:00:00Z")
    finish = time.parse("2026-05-02T00:00:00Z")
    diff = finish - start
    io.show("Diff: {diff}")
    short = 500.ms
    io.show("Half second: {short}")
    stop(self)
  }
}

run(Timer)

# Tests — run with: keel test examples/time_basic.keel
test "parse, format, and parts" {
  parsed = time.parse("2026-05-01T09:00:00Z")
  formatted = parsed.format(as: "%Y-%m-%d") ?? ""
  assert formatted == "2026-05-01"
  p = parsed.parts()
  assert p.year == 2026
  assert p.month == 5
}

test "datetime arithmetic yields durations" {
  start = time.parse("2026-05-01T00:00:00Z")
  finish = time.parse("2026-05-02T00:00:00Z")
  assert finish - start == 1.days
}
