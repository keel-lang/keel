use std/ai
use std/io
use std/schedule

use std/testing

type Severity = info | warning | error

type ReviewResult {
  severity: Severity
  message: str
}

task review_code(diff: str) -> str {
  ai.draft("code review feedback for this diff:\n{diff}", tone: "constructive", guidance: "focus on bugs, security issues, and readability") ?? "(review failed)"
}

task assess_risk(diff: str) -> Severity {
  ai.classify(diff, as: Severity, considering: { "changes authentication or authorization": Severity.error, "modifies database schema": Severity.warning, "formatting or comment changes only": Severity.info }) ?? Severity.warning
}

test "risk assessment can be mocked" {
  testing.mock(ai.classify).returns(Severity.error)
  assert assess_risk("changes authentication") == Severity.error
}

test "review text can be mocked" {
  testing.mock(ai.draft).returns("check auth boundary")
  assert review_code("+ changed auth") == "check auth boundary"
}

agent CodeReviewer {
  @tools [io]
  @role "You are a thorough but kind code reviewer"

  state {
    reviews_done: int = 0
  }

  task process(pr: { title: str, diff: str, author: str }) {
    risk = assess_risk(pr.diff)
    feedback = review_code(pr.diff)
    io.show({ title: pr.title, author: pr.author, risk: risk, feedback: feedback })
    when risk {
      error => {
        io.notify("HIGH RISK: {pr.title} needs careful review")
        if io.confirm("Approve this PR?") {
          io.notify("PR approved")
        }
      }
      warning => io.notify("Review feedback posted for: {pr.title}")
      info => io.notify("Auto-approved: {pr.title} (low risk)")
    }
    self.reviews_done = self.reviews_done + 1
  }
  @on_start {
    schedule.every(5.minutes, () => {
      io.notify("Checking for PRs to review...")
      io.notify("Reviews completed: {self.reviews_done}")
    })
  }
}

run(CodeReviewer)
