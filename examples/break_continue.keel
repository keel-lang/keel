agent BreakContinueDemo {
  @on_start {
    for i in 1..10 {
      if i > 3 {
        break
      }
      Io.show("i={i}")
    }
    for n in 1..6 {
      if n == 3 {
        continue
      }
      Io.show("n={n}")
    }
    for outer in 1..3 {
      for inner in 1..10 {
        if inner > 2 {
          break
        }
        Io.show("outer={outer} inner={inner}")
      }
    }
  }
}

run(BreakContinueDemo)
