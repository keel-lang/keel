agent BreakContinueDemo {
    @on_start {
        # break — exit a loop early
        for i in 1..10 {
            if i > 3 {
                break
            }
            Io.show("i={i}")
        }
        # prints 1, 2, 3 then stops

        # continue — skip an iteration
        for n in 1..6 {
            if n == 3 {
                continue
            }
            Io.show("n={n}")
        }
        # prints 1, 2, 4, 5, 6 (3 is skipped)

        # break only exits the innermost loop
        for outer in 1..3 {
            for inner in 1..10 {
                if inner > 2 {
                    break
                }
                Io.show("outer={outer} inner={inner}")
            }
        }
        # outer runs 3 times; inner stops at 2 each time
    }
}

run(BreakContinueDemo)
