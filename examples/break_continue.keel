use std/io

agent BreakContinueDemo {
  @tools [io]
  @on_start {
    for i in 1..10 {
      if i > 3 {
        break
      }
      io.show("i={i}")
    }
    for n in 1..6 {
      if n == 3 {
        continue
      }
      io.show("n={n}")
    }
    for outer in 1..3 {
      for inner in 1..10 {
        if inner > 2 {
          break
        }
        io.show("outer={outer} inner={inner}")
      }
    }
  }
}

run(BreakContinueDemo)

# Tests — run with: keel test examples/break_continue.keel
test "break exits the innermost loop" {
  collected: list[int] = []
  for i in 1..10 {
    if i > 3 {
      break
    }
    collected += [i]
  }
  assert collected == [1, 2, 3]
}

test "continue skips one iteration" {
  kept: list[int] = []
  for n in 1..6 {
    if n == 3 {
      continue
    }
    kept += [n]
  }
  assert kept == [1, 2, 4, 5, 6]
}
