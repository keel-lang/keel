# Rich enum variant construction and destructuring.

use std/io

type Action =
  | reply { to: str, tone: str }
  | forward { to: str }
  | archive

task describe(a: Action) -> str {
  when a {
    reply { to, tone } => "reply to {to} ({tone})"
    forward { to } => "forward to {to}"
    archive => "archive"
  }
}

test "describe formats rich enum variants" {
  assert describe(Action.reply { to: "alice@example.com", tone: "friendly" }) == "reply to alice@example.com (friendly)"
  assert describe(Action.forward { to: "ops@example.com" }) == "forward to ops@example.com"
  assert describe(Action.archive) == "archive"
}

agent Demo {
  @tools [io]
  @role "Rich enum demo"

  @on_start {
    a = Action.reply { to: "alice@example.com", tone: "friendly" }
    b = Action.forward { to: "ops@example.com" }
    c = Action.archive

    io.notify(describe(a))
    io.notify(describe(b))
    io.notify(describe(c))
  }
}

run(Demo)
