agent SupportBot {
  @role "Customer support — handles order inquiries and refunds"

  state {
    confirmed: bool = false
    admin: bool = false
  }
  @tools [Email.fetch, Email.send if self.confirmed, Db.query, Db.exec if self.admin, Log]

  on message(msg: str) {
    when msg {
      "confirm" => {
        self.confirmed = true
        Log.info("user confirmed — Email.send now available")
      }
      "admin" => {
        self.admin = true
        Log.info("admin mode — Db.exec now available")
      }
      _ => Log.info("received: {msg}")
    }
  }
}

run(SupportBot)

Agent.send(SupportBot, "confirm")

Agent.send(SupportBot, "admin")
