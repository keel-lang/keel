use std/io
use std/json

interface Printable {
  task print(self) -> str
}

type Point {
  x: float
  y: float
}

type Color {
  r: int
  g: int
  b: int
}

impl Printable for Point {
  task print(self) -> str {
    "Point({self.x}, {self.y})"
  }
}

impl Printable for Color {
  task print(self) -> str {
    "rgb({self.r}, {self.g}, {self.b})"
  }
}

type Score {
  label: str
  val: int
}

impl Comparable for Score {
  task compare(self, other: Score) -> int {
    self.val - other.val
  }
}

impl Equatable for Point {
  task equals(self, other: Point) -> bool {
    self.x == other.x and self.y == other.y
  }
}

type Event {
  name: str
  count: int
}

impl Serializable for Event {
  task to_json(self) -> str {
    "name={self.name};count={self.count}"
  }
}

type NumRange {
  lo: int
  hi: int
}

impl Iterable for NumRange {
  task items(self) -> list[int] {
    result: list[int] = []
    i = self.lo
    while i <= self.hi {
      result += [i]
      i += 1
    }
    result
  }
}

task run_demo() {
  p: Point = { x: 1.5, y: 2.0 }
  c: Color = { r: 255, g: 128, b: 0 }
  io.show(p.print())
  io.show(c.print())
  scores: list[Score] = [{ label: "B", val: 70 }, { label: "A", val: 95 }, { label: "C", val: 60 }]
  sorted = scores.sort()
  for s in sorted {
    io.show("{s.label}: {s.val}")
  }
  a: Point = { x: 1.0, y: 2.0 }
  b: Point = { x: 1.0, y: 2.0 }
  io.show("equal: {a.equals(b)}")
  ev: Event = { name: "click", count: 42 }
  io.show(json.stringify(ev))
  r: NumRange = { lo: 1, hi: 4 }
  for n in r {
    io.show("{n}")
  }
}

run_demo()

# Tests — run with: keel test examples/interfaces.keel
test "impl methods dispatch by type" {
  p: Point = { x: 1.5, y: 2.5 }
  c: Color = { r: 255, g: 128, b: 0 }
  assert p.print() == "Point(1.5, 2.5)"
  assert c.print() == "rgb(255, 128, 0)"
}

test "comparable drives sort" {
  scores: list[Score] = [{ label: "B", val: 70 }, { label: "A", val: 95 }, { label: "C", val: 60 }]
  assert scores.sort().map(s => s.label).join("") == "CBA"
}

test "equatable compares by value" {
  a: Point = { x: 1.0, y: 2.0 }
  b: Point = { x: 1.0, y: 2.0 }
  assert a.equals(b)
}

test "serializable overrides json.stringify" {
  ev: Event = { name: "click", count: 42 }
  assert json.stringify(ev) == "name=click;count=42"
}

test "iterable yields items in a for loop" {
  r: NumRange = { lo: 1, hi: 4 }
  total = 0
  for n in r {
    total += n
  }
  assert total == 10
}
