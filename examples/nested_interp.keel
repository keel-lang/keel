# Nested String Interpolation
#
# Keel string interpolation slots `{...}` accept any expression — including
# another string literal with its own slots. The lexer tracks brace depth
# so quotes inside `{}` are not confused with the outer string's terminator.
#
# Demonstrates: nested `"..."` inside `{interp}`, recursive interpolation.
#
# Run:
#   KEEL_LLM=mock KEEL_ONESHOT=1 keel run examples/nested_interp.keel

agent Greeter {
  @on_start {
    name = "world"
    mood = "cheerful"

    # Outer string contains a `{...}` slot whose body is itself a string
    # literal with another nested slot.
    msg = "hi {"there {name}"}"
    Io.show(msg)

    # Mix conditional and method-call expressions inside the slot.
    detail = "tone: {"speaking in a {mood.to_str()} voice"}"
    Io.show(detail)
  }
}

run(Greeter)
