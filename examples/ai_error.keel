use std/ai
use std/io

use std/testing

type Urgency = low | medium | high | critical

task safe_classify(text: str) -> Urgency {
  ai.classify(text, as: Urgency) ?? Urgency.medium
}

test "safe classify uses mocked urgency" {
  testing.mock(ai.classify).returns(Urgency.critical)
  assert safe_classify("server is down!") == Urgency.critical
}

agent ErrorDemo {
  @tools [ai, io]
  @role "You triage support tickets by urgency"
  @on_start {
    urgency = safe_classify("server is down!")
    io.show("Classified as: {urgency}")
    try {
      result = ai.classify("some ambiguous text", as: Urgency) ?? Urgency.medium
      io.show("Result: {result}")
    } catch err: AiSchemaError {
      io.show("LLM gave unexpected output: {err.got}")
      result = Urgency.medium
    } catch err: Error {
      io.show("Unexpected error: {err.message}")
    }
    stop(self)
  }
}

run(ErrorDemo)
