task format_greeting(name: str) -> str {
  greeting = "Hello, " + name + "!"
  greeting
}

agent Greeter {
  state {
    call_count: int = 0
  }
  @on_start {
    msg = format_greeting("World")
    Io.show(msg)
    self.call_count = self.call_count + 1
    total = self.call_count
    Io.show(total)
  }
}

run(Greeter)
