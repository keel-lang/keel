# Data Pipeline Agent
#
# Validates and enriches a batch of records on a schedule.
#
# v0.1.5 features demonstrated:
#   - Named struct type (Record) used as task parameters and local variables
#   - Struct field checks: the checker verifies literals match the declared type
#   - Return-type matching: validate() -> Status, enrich() -> str
#   - Nullable unwrapping: ai.draft returns str?, coalesced with ??
#   - List method type inference: .filter() preserves list[Record],
#     .len() returns int, .map() produces list[str]
#
# Run:
#   KEEL_LLM=mock KEEL_ONESHOT=1 keel run examples/data_pipeline.keel

use std/ai
use std/email
use std/io
use std/schedule

use std/testing

type Status = valid | invalid | needs_review

type Record {
  name:  str
  email: str
  score: int
}

task validate(r: Record) -> Status {
  if r.email.is_empty() {
    return Status.invalid
  }
  if r.score < 0 {
    return Status.invalid
  }
  if r.score > 100 {
    return Status.needs_review
  }
  Status.valid
}

task enrich(r: Record) -> str {
  # ai.draft returns str? — use ?? to guarantee a str return type.
  ai.draft(
    "one-line profile summary for {r.name} (score: {r.score})",
    format: prose
  ) ?? "{r.name}: score {r.score}"
}

test "validate maps records to statuses" for case in [
  { record: { name: "Alice", email: "alice@co.com", score: 95 }, expected: Status.valid },
  { record: { name: "Bob", email: "", score: 72 }, expected: Status.invalid },
  { record: { name: "Charlie", email: "charlie@co.com", score: 150 }, expected: Status.needs_review }
] {
  record: Record = case.record
  assert validate(record) == case.expected
}

test "enrich uses setup and mocked draft sequence" {
  setup {
    alice: Record = { name: "Alice", email: "alice@co.com", score: 95 }
    diana: Record = { name: "Diana", email: "diana@co.com", score: 88 }
  }

  testing.mock(ai.draft).returns("Alice: top account")
  testing.mock(ai.draft).returns("Diana: renewal candidate")

  assert enrich(alice) == "Alice: top account"
  assert enrich(diana) == "Diana: renewal candidate"
  assert enrich(alice) == "Diana: renewal candidate"
  assert ai.draft.called
  assert ai.draft.call_count == 3
  assert ai.draft.called_with("one-line profile summary for Alice (score: 95)")
}

agent DataPipeline {
  @tools [ai, io]
  @role "You process and validate data records"

  state {
    total:         int = 0
    valid_count:   int = 0
    invalid_count: int = 0
  }

  @on_start {
    schedule.every(1.hour, () => {
      records: list[Record] = [
        { name: "Alice",   email: "alice@co.com",   score: 95 },
        { name: "Bob",     email: "",               score: 72 },
        { name: "Charlie", email: "charlie@co.com", score: 150 },
        { name: "Diana",   email: "diana@co.com",   score: 88 },
        { name: "Eve",     email: "eve@co.com",     score: -5 }
      ]

      io.notify("Processing {records.len()} records...")

      for r in records {
        status = validate(r)
        self.total = self.total + 1

        when status {
          valid => {
            self.valid_count = self.valid_count + 1
            summary = enrich(r)
            io.notify("  OK:     {summary}")
          }
          invalid => {
            self.invalid_count = self.invalid_count + 1
            io.notify("  SKIP:   {r.name} (invalid)")
          }
          needs_review => {
            io.notify("  REVIEW: {r.name} (score: {r.score})")
          }
        }
      }

      # .filter preserves list[Record]; .map produces list[unknown] (lambda return)
      valid_records = records.filter(r => validate(r) == Status.valid)
      valid_names   = valid_records.map(r => r.name)

      n_valid:   int = valid_records.len()
      n_invalid: int = self.invalid_count
      n_total:   int = self.total

      io.notify("Valid names: {valid_names}")
      io.notify("Stats: {n_valid}/{n_total} valid, {n_invalid} invalid")
    })
  }
}

run(DataPipeline)
