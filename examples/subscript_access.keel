use std/io

agent Demo {
  @tools [io]
  @on_start {
    items = ["alpha", "beta", "gamma"]

    first = items[0]
    io.show(first)

    mid = items[1]
    io.show(mid)

    scores = [42, 17, 99, 5]
    top = scores[2]
    io.show(top)

    word = "keel"
    ch0 = word[0]
    ch3 = word[3]
    io.show(ch0)
    io.show(ch3)
  }
}

run(Demo)

# Tests — run with: keel test examples/subscript_access.keel
test "subscripts index lists and strings" {
  items = ["alpha", "beta", "gamma"]
  assert items[0] == "alpha"
  assert [42, 17, 99, 5][2] == 99
  word = "keel"
  assert word[0] == "k"
  assert word[3] == "l"
}
