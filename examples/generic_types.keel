type Paginated[T] {
  items: list[T]
  page: int
  has_more: bool
}

type Pair[A, B] {
  first: A
  second: B
}

type Bag[T] = list[T]

type Outcome[T] =
  | ok { value: T }
  | err { message: str }

task summarise_page(page: Paginated[str]) -> str {
  total = page.items.len()
  "{total} item(s) on page {page.page}"
}

agent Demo {
  @role "Demonstrates generic types"
  @on_start {
    page: Paginated[str] = { items: ["alpha", "beta", "gamma"], page: 1, has_more: false }
    summary = summarise_page(page)
    Io.show(summary)
    coords: Pair[str, int] = { first: "x", second: 42 }
    Io.show("first={coords.first}, second={coords.second}")
    tags: Bag[str] = ["rust", "keel", "generic"]
    Io.show("{tags.len()} tag(s)")
  }
}

run(Demo)
