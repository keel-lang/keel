use std/io

type Paginated[T] {
  items: list[T]
  page: int
  has_more: bool
}

type Pair[A, B] {
  first: A
  second: B
}

type Bag[T] = list[T]

type Outcome[T] =
  | ok { value: T }
  | err { message: str }

task summarise_page(page: Paginated[str]) -> str {
  total = page.items.len()
  "{total} item(s) on page {page.page}"
}

agent Demo {
  @role "Demonstrates generic types"
  @on_start {
    page: Paginated[str] = { items: ["alpha", "beta", "gamma"], page: 1, has_more: false }
    summary = summarise_page(page)
    io.show(summary)
    coords: Pair[str, int] = { first: "x", second: 42 }
    io.show("first={coords.first}, second={coords.second}")
    tags: Bag[str] = ["rust", "keel", "generic"]
    io.show("{tags.len()} tag(s)")
  }
}

run(Demo)

# Tests — run with: keel test examples/generic_types.keel
test "generic struct fields keep their element type" {
  page: Paginated[str] = { items: ["alpha", "beta", "gamma"], page: 1, has_more: false }
  assert summarise_page(page) == "3 item(s) on page 1"
}

test "pairs carry two independent type params" {
  coords: Pair[str, int] = { first: "x", second: 42 }
  assert coords.first == "x"
  assert coords.second == 42
}
