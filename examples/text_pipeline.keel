agent TextPipeline {
    @on_start {
        text = "Invoice #1042 — Total: $3,750.00 due 2026-05-15"

        # Regex test
        if text.matches("\\d{4}-\\d{2}-\\d{2}") {
            Io.show("Found a date")
        }

        # Extract first capture group
        amount = text.extract("\\$(\\S+)")
        Io.show("Amount: {amount}")

        invoice = text.extract("#(\\d+)")
        Io.show("Invoice: {invoice}")

        # Truncate long strings
        short = text.truncate(20)
        Io.show("Short: {short}")

        # Pad for alignment
        label1 = "ID".pad(10)
        label2 = "Amount".pad(10)
        Io.show("{label1}{label2}")

        # Zero-padded invoice number
        padded_id = invoice.pad(6, char: "0")
        Io.show("Padded ID: {padded_id}")

        # Find all dates in text
        dates = text.find_all("\\d{4}-\\d{2}-\\d{2}")
        Io.show("Dates found: {dates.count}")

        # Regex replace
        redacted = text.sub("\\$[\\d,]+\\.\\d{2}", "[REDACTED]")
        Io.show("Redacted: {redacted}")
    }
}
run(TextPipeline)
