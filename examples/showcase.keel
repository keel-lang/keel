use std/ai
use std/io

use std/testing

type Severity = low | medium | high | critical

type Action =
  | page { who: str }
  | notify { channel: str }
  | log

type Incident {
  id: str
  title: str
  service: str
}

agent Responder {
  @tools [ai, io]
  @role "Senior on-call engineer — handles critical and high production incidents"
  @rules ["Open every response with a one-line impact statement", "Always include an estimated time-to-resolve"]

  state {
    handled: int = 0
  }

  on escalate(incident: Incident) {
    self.handled = self.handled + 1
    tone = if self.handled > 5 { "concise" } else { "thorough" }
    runbook = ai.draft("Incident response runbook for: {incident.title} in the {incident.service} service", tone: tone, guidance: "cover immediate mitigation and rollback steps") ?? "(no runbook generated)"
    io.show("[Responder #{self.handled}] {incident.id}: {incident.title}")
    io.show(runbook)
  }
  @on_stop {
    io.show("Responder offline — handled {self.handled} escalations this shift")
  }
}

task classify_severity(incident: Incident) -> Severity {
  ai.classify("{incident.title} in {incident.service}", as: Severity, considering: { "payment, checkout, auth, data loss, outage": Severity.critical, "latency, degraded, elevated error rate": Severity.high }) ?? Severity.low
}

task choose_action(severity: Severity) -> Action {
  when severity {
    critical => Action.page { who: "primary on-call" }
    high => Action.notify { channel: "#incidents" }
    medium, low => Action.log
  }
}

test "severity classification can be mocked" {
  testing.mock(ai.classify).returns(Severity.critical)
  incident: Incident = { id: "INC-999", title: "Checkout outage", service: "payments" }
  assert classify_severity(incident) == Severity.critical
}

test "choose action maps severities" {
  assert choose_action(Severity.critical) == Action.page { who: "primary on-call" }
  assert choose_action(Severity.high) == Action.notify { channel: "#incidents" }
  assert choose_action(Severity.low) == Action.log
}

agent OnCall {
  @tools [ai, io]
  @role "On-call coordinator — triage every alert, never drop a critical one"
  @rules ["Escalate anything that affects revenue or user data immediately", "Log every decision with the severity and chosen action"]

  state {
    escalated: int = 0
    logged: int = 0
    seen: list[str] = []
  }
  @on_start {
    run(Responder)
    batch_a = [{ id: "INC-101", title: "Checkout 500 errors spiking", service: "payments" }, { id: "INC-102", title: "High latency on search API", service: "search" }]
    batch_b = [{ id: "INC-103", title: "Expired SSL cert on staging", service: "infra" }]
    incidents = batch_a + batch_b
    incidents = incidents.push({ id: "INC-104", title: "Auth token validation failing", service: "auth" })
    total: int = incidents.count()
    io.show("OnCall shift starting — {total} incidents in queue")
    for incident in incidents {
      severity = classify_severity(incident)
      action = choose_action(severity)
      badge = if severity == Severity.critical { "[CRIT]" } else if severity == Severity.high { "[HIGH]" } else { "[    ]" }
      io.show("{badge} {incident.id} — {incident.title} ({self.escalated + self.logged + 1} of {total})")
      when action {
        page { who } => {
          delegate(Responder, "escalate", incident)
          self.escalated = self.escalated + 1
          self.seen = self.seen.push(incident.id)
          io.show("  paged {who}")
        }
        notify { channel } => {
          self.logged = self.logged + 1
          self.seen = self.seen.push(incident.id)
          io.show("  notified {channel}")
        }
        log => {
          self.logged = self.logged + 1
          io.show("  logged")
        }
      }
    }
    summary = ai.summarize("{self.escalated} escalated, {self.logged} logged out of {total} incidents", format: prose, max: 1, unit: sentences) ?? "shift complete"
    io.show("Shift summary: {summary}")
    stop(OnCall)
  }
  @on_stop {
    io.show("OnCall shift complete. Escalated: {self.escalated}. Logged: {self.logged}.")
  }
}

run(OnCall)
