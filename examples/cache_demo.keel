use std/cache
use std/io

agent CacheDemo {
    @tools [io]
    @on_start {
        # Basic set and get
        cache.set("greeting", "Hello, Keel!")
        val = cache.get("greeting")
        io.show(val)

        # Set with TTL
        cache.set("token", "abc123", ttl: 5.minutes)
        token = cache.get("token")
        io.show("Token: {token}")

        # Delete a key
        cache.set("temp", "remove-me")
        cache.delete("temp")
        gone = cache.get("temp")
        if gone == none {
            io.show("key deleted")
        }

        # Clear all entries
        cache.set("a", "1")
        cache.set("b", "2")
        cache.clear()
        empty = cache.get("a")
        if empty == none {
            io.show("cache cleared")
        }
    }
}
run(CacheDemo)

# Tests — run with: keel test examples/cache_demo.keel
test "set then get round-trips" {
  cache.set("greeting", "Hello, Keel!")
  assert cache.get("greeting") == "Hello, Keel!"
}

test "delete and clear remove entries" {
  cache.set("temp", "remove-me")
  cache.delete("temp")
  assert cache.get("temp") == none
  cache.set("a", "1")
  cache.clear()
  assert cache.get("a") == none
}
