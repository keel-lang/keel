type Sentiment = positive | neutral | negative

task sentiment_of(text: str) -> Sentiment {
  Ai.classify(text, as: Sentiment) ?? Sentiment.neutral
}

task summarize_or_default(text: str) -> str {
  Ai.summarize(text, format: prose, max: 1, unit: sentences) ?? "No summary available."
}

task env_config() -> str {
  host: str = Env.get("KEEL_HOST") ?? "localhost"
  port: str = Env.get("KEEL_PORT") ?? "8080"
  "{host}:{port}"
}

agent NullableDemo {
  @role "Demonstrates nullable type safety"
  @on_start {
    texts = ["The team shipped a great release today!", "Service is degraded — latency is up 3x.", "Routine maintenance completed successfully."]
    for text in texts {
      sentiment = sentiment_of(text)
      summary = summarize_or_default(text)
      label = if sentiment == Sentiment.positive { "good news" } else if sentiment == Sentiment.negative { "incident" } else { "routine" }
      Io.show("[{label}] {summary}")
    }
    endpoint: str = env_config()
    Io.show("Connecting to {endpoint}")
  }
}

run(NullableDemo)
