use std/io

agent SessionBot {
  @tools [io]
  @role "Answer questions for the current session"

  state {
    turns: int = 0
    session_id: readonly str = "default-session"
  }
  @on_start {
    io.show("Session started: " + self.session_id)
  }

  on message(msg: str) {
    self.turns = self.turns + 1
    io.show("Turn {self.turns} in session {self.session_id}")
  }
}

run(SessionBot)
