fn shout(s: str) -> str {
  return (s + "!")
}

fn describe(n: int) -> str {
  let <when.result>: str
  if (n == 0) {
    <when.result> = "zero"
  } else {
    if true {
      <when.result> = "nonzero"
    }
  }
  return shout(<when.result>)
}

fn rank(n: int) -> int {
  let <when.result>: int
  if (n == 0) {
    <when.result> = 1
  } else {
    if true {
      <when.result> = 2
    }
  }
  return (100 + <when.result>)
}

fn tag(n: int, label: str) -> str {
  let <spill>: str = label
  let <when.result>: str
  if (n == 0) {
    <when.result> = "zero"
  } else {
    if true {
      <when.result> = "nonzero"
    }
  }
  return (<spill> + shout(<when.result>))
}

fn <toplevel>() -> none {
}
