fn while_break(n: int) -> int {
  let i: int = 0
  while (i < n) {
    if (i == 3) {
      break
    }
    i = (i + 1)
  }
  return i
}

fn for_index_continue() -> int {
  let seen: int = 0
  for i in 1..5 {
    if (i == 3) {
      continue
    }
    seen = (seen + 1)
  }
  return seen
}

fn for_each_continue(xs: list[int]) -> int {
  let seen: int = 0
  for x in xs {
    if (x == 3) {
      continue
    }
    seen = (seen + 1)
  }
  return seen
}

fn <toplevel>() -> none {
}
