fn shout(s: str) -> str {
  return (s + "!")
}

fn describe(n: int) -> str {
  let <if.result>: str
  if (n == 0) {
    <if.result> = "zero"
  } else {
    <if.result> = "nonzero"
  }
  return shout(<if.result>)
}

fn rank(n: int) -> int {
  let <if.result>: int
  if (n == 0) {
    <if.result> = 1
  } else {
    <if.result> = 2
  }
  return (100 + <if.result>)
}

fn tag(n: int, label: str) -> str {
  let <spill>: str = label
  let <if.result>: str
  if (n == 0) {
    <if.result> = "zero"
  } else {
    <if.result> = "nonzero"
  }
  return (<spill> + shout(<if.result>))
}

fn mix(n: int) -> str {
  let <if.result>: str
  if (n == 0) {
    <if.result> = "zero"
  } else {
    if (n == 1) {
      <if.result> = "one"
    } else {
      if true {
        <if.result> = "many"
      }
    }
  }
  return shout(<if.result>)
}

fn arm(n: int, c: bool) -> str {
  if (n == 0) {
    let <if.result>: str
    if c {
      <if.result> = "a"
    } else {
      <if.result> = "b"
    }
    return <if.result>
  } else {
    if true {
      return "z"
    }
  }
}

fn <toplevel>() -> none {
}
